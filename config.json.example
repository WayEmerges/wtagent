{
  "defaultModel": "auto",
  "auto": {
    "fallback": "brain",
    "threshold": 0.75
  },
  "lease": {
    "adapter": "noop",
    "lockPath": "~/.waytech-agent/gpu.lock",
    "acquireTimeoutMs": 600000
  },
  "memory": {
    "enabled": true,
    "dir": "~/.waytech-agent/memory",
    "threshold": 0.75,
    "keepRecentMessages": 0,
    "summarizer": "summarizer",
    "injectChars": 12000
  },
  "models": {
    "brain": {
      "name": "Brain",
      "baseURL": "http://YOUR_HOST:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen2.5-Coder-32B-Instruct-AWQ",
      "contextLength": 32768,
      "roles": ["chat", "plan"]
    },
    "coder": {
      "name": "Coder",
      "baseURL": "http://YOUR_HOST:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen2.5-Coder-32B-Instruct-AWQ",
      "contextLength": 32768,
      "roles": ["agent", "code"]
    },
    "summarizer": {
      "name": "Summarizer",
      "baseURL": "http://YOUR_HOST:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen2.5-Coder-32B-Instruct-AWQ",
      "contextLength": 32768,
      "roles": ["summarize"]
    }
  }
}
