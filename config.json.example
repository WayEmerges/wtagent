{
  "defaultModel": "main",
  "models": {
    "main": {
      "name": "Local Main",
      "baseURL": "http://100.110.242.67:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen3.6-27B",
      "contextLength": 190000,
      "roles": ["chat", "agent"]
    },
    "brain": {
      "name": "Brain",
      "baseURL": "http://100.110.242.67:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen3.6-27B",
      "contextLength": 190000,
      "roles": ["chat", "plan"]
    },
    "coder": {
      "name": "Coder",
      "baseURL": "http:/100.110.242.67:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen3.6-27B",
      "contextLength": 190000,
      "roles": ["agent", "code"]
    },
    "summarizer": {
      "name": "Summarizer",
      "baseURL": "http://100.110.242.67:8001/v1",
      "apiKey": "local",
      "model": "Qwen/Qwen3.6-27B",
      "contextLength": 190000,
      "roles": ["summarize"]
    }
  },
  "auto": {
    "fallback": "brain",
    "threshold": 0.75
  },
  "lease": {
    "adapter": "noop",
    "lockPath": "~/.waytech-agent/gpu.lock",
    "acquireTimeoutMs": 600000
  },
  "memory": {
    "enabled": true,
    "dir": "~/.waytech-agent/memory",
    "threshold": 0.75,
    "keepRecentMessages": 0,
    "summarizer": "summarizer",
    "injectChars": 12000
  }
}
